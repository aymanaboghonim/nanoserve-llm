# NanoServe environment reference.
# Copy to `.env` and adjust for your machine. Every variable is optional;
# defaults are the hardware-fencing constants from the Blueprint.
#
#   cp .env.example .env

# --- Hardware fencing -----------------------------------------------------
NANOSERVE_SYSTEM_RAM_GB=12.0
NANOSERVE_GPU_VRAM_GB=8.0
NANOSERVE_GPU_MEMORY_UTILIZATION=0.80  # vLLM --gpu-memory-utilization -> 6.4GB cap (Granite-4.2-3B AWQ INT4 + fp8 KV, 32K ctx)

# --- Serving plane (Phase 3: vLLM OpenAI-compatible endpoint) ------------
# http://localhost:8000/v1 is the immutable Repository-2 contract (gateway
# listener on :8000 + /healthz).
NANOSERVE_BASE_URL=http://localhost:8000/v1
NANOSERVE_MODEL=ibm-granite/granite-4.2-3b
NANOSERVE_API_KEY=EMPTY
NANOSERVE_REQUEST_TIMEOUT_S=120.0
NANOSERVE_MAX_RETRIES=2

# --- Load testing (Phase 5: Locust) --------------------------------------
NANOSERVE_LOAD_USERS=8
NANOSERVE_LOAD_SPAWN_RATE=1
NANOSERVE_LOAD_RUN_TIME=1m
NANOSERVE_LOAD_MAX_TOKENS=128
NANOSERVE_LOAD_PROMPT=Explain the concept of a KV cache in one sentence.
# Realistic stress (make stress): per-user context length in tokens, turn count
# per conversation, thinking on/off, and the ramp/plateau/spike shape knobs.
# NANOSERVE_LOAD_CONTEXT_TOKENS=2048
# NANOSERVE_LOAD_TURNS=3
# NANOSERVE_LOAD_THINKING=0
# NANOSERVE_LOAD_SHAPE=0
# NANOSERVE_LOAD_WARMUP_S=15
# NANOSERVE_LOAD_PLATEAU_S=60
# NANOSERVE_LOAD_SPIKE_S=30
# NANOSERVE_LOAD_SPIKE_HOLD_S=30
# NANOSERVE_LOAD_SPIKE_USERS=28
# RAG-style multi-turn sessions (@seq_task cycles; context resets after N turns)
NANOSERVE_LOAD_TURNS=3
# Short think-time between turns (0.2-1.0s) = dense bursts that actually fill
# the KV pool / form a scheduler queue (the old 2-5s left the pool near 0%).
NANOSERVE_LOAD_THINK_MIN=0.2
NANOSERVE_LOAD_THINK_MAX=1.0
# Granite-4.2 thinking (defaults ON in the template — burns the max_tokens
# budget): OFF for throughput tests; 1 + max_tokens ~256 to load reasoning.
NANOSERVE_LOAD_THINKING=0
# LoadTestShape (ramp -> plateau -> end-of-window spike): set 1 or `make stress`.
NANOSERVE_LOAD_SHAPE=0
NANOSERVE_LOAD_SPIKE_USERS=28

# --- Evaluation (Phase 5: DeepEval LLM-as-judge) --------------------------
NANOSERVE_EVAL_JUDGE_MODEL=ibm-granite/granite-4.2-3b
NANOSERVE_EVAL_THRESHOLD=0.5
# Set to 1 only when the vLLM endpoint is live:
NANOSERVE_EVAL_LIVE=0

# --- E2E contract gate (tests/e2e — Repository 2 readiness) ---------------
# Set to 1 to run the live contract suites (healthz / streaming / tool-calling
# / Tier-2 route). Plain `pytest` skips them at collection time.
NANOSERVE_E2E_LIVE=0

# --- Portable conformance suite (contract_tests — decoupled Repo-2 gate) ---
# Set to 1 to run against a live endpoint. BASE_URL/MODEL are consumer-side
# (defaults: localhost:8000/v1 + the served granite model). Run via
# `make contract-test` (auto-resolves the gateway) or directly:
#   NANOSERVE_CONTRACT_LIVE=1 pytest contract_tests -v
NANOSERVE_CONTRACT_LIVE=0
# NANOSERVE_BASE_URL=http://localhost:8000/v1
# NANOSERVE_MODEL=ibm-granite/granite-4.2-3b

# --- Logging --------------------------------------------------------------
NANOSERVE_LOG_LEVEL=INFO

# --- Tier-2 (cloud Google AI Studio / Gemini) -----------------------------
# Used by `make secret` to render manifests/serving/secret-gemini.yaml.
# Never committed; keep in the gitignored .env. The Secret key stays `apiKey`
# (EAG requirement) and is injected into the upstream Authorization header.
GEMINI_API_KEY=AIza...
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Model download pipeline (scripts/download_model.sh) ------------------
# Override the host-side flat model cache root (static hostPath PV target).
# Defaults to ~/.cache/nanoserve/models/<model-id>.
# NANOSERVE_MODEL_CACHE=/custom/path
# HF cache dir defaults to ~/.cache/huggingface (hub layout); override with
# HF_HOME or HF_HUB_CACHE. If your ISP throttles huggingface.co, set:
# HF_ENDPOINT=https://hf-mirror.com

# --- Telemetry (Phase 4: Grafana admin) ------------------------------------
# Used by `make secret-grafana` to render manifests/telemetry/grafana-secret.yaml.
# Never committed; keep in the gitignored .env.
GRAFANA_ADMIN_PASSWORD=change-me
