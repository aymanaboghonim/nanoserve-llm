# NanoServe environment reference.
# Copy to `.env` and adjust for your machine. Every variable is optional;
# defaults are the hardware-fencing constants from the Blueprint.
#
#   cp .env.example .env

# --- Hardware fencing -----------------------------------------------------
NANOSERVE_SYSTEM_RAM_GB=12.0
NANOSERVE_GPU_VRAM_GB=8.0
NANOSERVE_GPU_MEMORY_UTILIZATION=0.5   # vLLM --gpu-memory-utilization -> 4GB KV+weights cap

# --- Serving plane (Phase 3: vLLM OpenAI-compatible endpoint) ------------
NANOSERVE_BASE_URL=http://localhost:8000/v1
NANOSERVE_MODEL=Qwen/Qwen2.5-1.5B-Instruct-AWQ
NANOSERVE_API_KEY=EMPTY
NANOSERVE_REQUEST_TIMEOUT_S=120.0
NANOSERVE_MAX_RETRIES=2

# --- Load testing (Phase 5: Locust) --------------------------------------
NANOSERVE_LOAD_USERS=8
NANOSERVE_LOAD_SPAWN_RATE=1
NANOSERVE_LOAD_RUN_TIME=1m
NANOSERVE_LOAD_MAX_TOKENS=64
NANOSERVE_LOAD_PROMPT=Explain the concept of a KV cache in one sentence.

# --- Evaluation (Phase 5: DeepEval LLM-as-judge) --------------------------
NANOSERVE_EVAL_JUDGE_MODEL=Qwen/Qwen2.5-1.5B-Instruct-AWQ
NANOSERVE_EVAL_THRESHOLD=0.5
# Set to 1 only when the vLLM endpoint is live:
NANOSERVE_EVAL_LIVE=0

# --- Logging --------------------------------------------------------------
NANOSERVE_LOG_LEVEL=INFO
